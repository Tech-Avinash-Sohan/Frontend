# API path prefix (the dev server forwards /api to the backend below)
VITE_API_BASE_URL=/api/v1

# Your Django server (school_erp_backend) while developing
VITE_BACKEND_URL=http://localhost:8000

# Length of the reset-password OTP sent by the backend
VITE_OTP_LENGTH=4

# Print every API call + payload in the browser console (default: on with npm run dev, off in a build)
# VITE_LOG_API=true
